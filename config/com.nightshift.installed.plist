<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nightshift</string>
  <!-- macOS TCC hangs (never errors, blocks forever in `open`/`getcwd`) any HEADLESS background
       daemon -- launchd LaunchAgent, no WindowServer session -- that touches an external volume,
       across every process identity it forks (jac's python, git, claude, ...), not just the first.
       Full Disk Access on individual binaries doesn't scale to a whole toolchain. Fix: have launchd
       ask Terminal.app to run the script instead of running it directly. A real Terminal session is
       NOT subject to this restriction (same reason a manual `bin/nightshift.sh run` from an
       interactive terminal always worked fine) -- osascript's automation of Terminal needs a
       one-time "Allow" click the first time this fires. -->
  <key>ProgramArguments</key><array>
    <string>/usr/bin/osascript</string>
    <string>-e</string>
    <string>tell application "Terminal" to do script "/Volumes/ExtremePro/JaseciLabs/NightShift/bin/nightshift.sh run; exit"</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer>
  </dict>
  <!-- These are opened BY LAUNCHD before spawning osascript, so they must live on internal disk.
       The harness's own detailed logs still go to the volume as always. -->
  <key>StandardOutPath</key><string>/Users/ayush/Library/Logs/nightshift-launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/ayush/Library/Logs/nightshift-launchd.err</string>
</dict></plist>
