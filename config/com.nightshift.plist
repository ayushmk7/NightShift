<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.nightshift</string>
  <!-- Assumes the standard internal-disk layout (~/nightshift): a plain launchd daemon can read/exec
       here fine, no special handling needed. nightshift.sh self-caffeinates + self-timeboxes
       internally (bin/nightshift.sh ns_run()), so ProgramArguments stays a direct bash invocation.

       IF THIS REPO LIVES ON AN EXTERNAL VOLUME instead: macOS TCC hangs (blocks forever, no error)
       any headless launchd daemon that touches an external volume, across every process identity it
       forks -- Full Disk Access on individual binaries does not scale to a whole toolchain (jac,
       git, claude, python, ...). Use config/com.nightshift.installed.plist's pattern instead: have
       launchd ask Terminal.app to run the script (osascript `do script`), since a real Terminal
       session is not subject to this restriction. -->
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string>
    <string>/Users/YOURUSER/nightshift/bin/nightshift.sh</string><string>run</string>
  </array>
  <key>StartCalendarInterval</key><dict>
    <key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer>
  </dict>
  <key>EnvironmentVariables</key><dict>
    <!-- launchd's minimal PATH is the #1 documented cause of silent failures (TPRD row 15) -->
    <key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key><string>/Users/YOURUSER/nightshift/logs/launchd.out</string>
  <key>StandardErrorPath</key><string>/Users/YOURUSER/nightshift/logs/launchd.err</string>
</dict></plist>
